{
  "name": "checkin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "frontend": "next dev",
    "backend": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "test:integration": "node --env-file-if-exists=.env.test.local --import tsx --test --test-concurrency=1 \"convex/**/*.integration.test.ts\"",
    "test:integration:deploy": "node --env-file=.env.test.local node_modules/convex/bin/main.js deploy -y"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.11",
    "convex": "^1.46.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
