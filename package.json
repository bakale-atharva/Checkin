{
  "name": "checkin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "frontend": "next dev",
    "backend": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "test:integration": "node --env-file-if-exists=.env.test.local --import tsx --test --test-concurrency=1 \"convex/**/*.integration.test.ts\"",
    "test:integration:deploy": "node --env-file=.env.test.local node_modules/convex/bin/main.js deploy -y",
    "test:e2e": "playwright test",
    "seed": "convex run listingSeeds:seedDemo",
    "seed:reset": "convex run listingSeeds:resetDemo",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.11",
    "@number-flow/react": "^0.6.2",
    "@visx/event": "4.0.0",
    "@visx/gradient": "4.0.0",
    "@visx/grid": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "d3-array": "^3.2.4",
    "lucide-react": "^1.57.0",
    "mapbox-gl": "3.33.0",
    "motion": "^14.3.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@clerk/testing": "^2.2.47",
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.10",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
